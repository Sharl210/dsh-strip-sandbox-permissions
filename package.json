{
  "name": "dsh-strip-sandbox-permissions",
  "description": "Strip placeholder tool-call arguments that DSH rejects: sandbox_permissions / justification (false sandbox escalation) and empty reasoning_effort (rejected subagent delegation).",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "scripts": {
    "test": "node test/sanitize.test.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "sandbox",
    "permissions",
    "escalation",
    "reasoning-effort",
    "subagent",
    "delegation",
    "tool-call"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
